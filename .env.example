# Server
PORT=3000
NODE_ENV=development
# Auth servicio-a-servicio: si se define, /tools y /agent exigen el header x-internal-api-key
INTERNAL_API_KEY=

# Database (SQL Server)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=YourDatabaseName
DB_USER=your_user
DB_PASSWORD=your_password
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Claude (ANTHROPIC_API_KEY is also accepted)
CLAUDE_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
