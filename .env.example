NODE_ENV=development
PORT=3000

# Database engine: "sqlserver" (default, port 1433) or "postgres" (port 5432)
DB_ENGINE=sqlserver
DB_HOST=localhost
DB_PORT=1433
DB_NAME=YourDatabaseName
DB_USER=your_user
DB_PASSWORD=your_password
DB_ENCRYPT=false
DB_TRUST_CERT=true

CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-3-5-sonnet-latest
